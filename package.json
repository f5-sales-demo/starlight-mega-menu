  "scripts": {
    "test": "npm run typecheck && TSX_TSCONFIG_PATH=tests/tsconfig.json node --import tsx --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@astrojs/react": ">=6.0.4",
    "@astrojs/starlight": ">=0.41.9",
    "react": ">=19.2.8",
    "react-dom": ">=19.2.8"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@f5-sales-demo/i18n-core": "^1.0.56",
    "@radix-ui/react-navigation-menu": "^1.2.22"
  }
